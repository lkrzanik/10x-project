@model _10xPV.Models.Correlation.CorrelationViewModel
@{
    ViewData["Title"] = "Korelacja danych";
}

<h1 class="mb-4">Korelacja danych klimatycznych</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(value => value.Errors))
        {
            <div>@modelError.ErrorMessage</div>
        }
    </div>
}

<form method="get" asp-action="Correlation" asp-controller="ClimateCorrelation" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label" for="from">Od</label>
        <input id="from" type="date" name="from" class="form-control" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="to">Do</label>
        <input id="to" type="date" name="to" class="form-control" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Oblicz korelację</button>
        <a asp-action="Correlation" asp-controller="ClimateCorrelation" class="btn btn-outline-secondary">Wyczyść</a>
    </div>
</form>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Extremes" asp-controller="ClimateCorrelation" class="btn btn-outline-primary">Pokaż ekstrema</a>
</div>

@if (Model.HasResults)
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Czujnik → oś pogody</h5>
                    <p class="mb-1"><strong>Punkty interpolowane:</strong> @Model.SensorMetadata?.InterpolatedCount</p>
                    <p class="mb-1"><strong>Punkty odrzucone:</strong> @Model.SensorMetadata?.DroppedCount</p>
                    <p class="mb-0"><strong>Poza zakresem:</strong> @Model.SensorMetadata?.OutOfRangeCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Pogoda → oś czujnika</h5>
                    <p class="mb-1"><strong>Punkty interpolowane:</strong> @Model.WeatherMetadata?.InterpolatedCount</p>
                    <p class="mb-1"><strong>Punkty odrzucone:</strong> @Model.WeatherMetadata?.DroppedCount</p>
                    <p class="mb-0"><strong>Poza zakresem:</strong> @Model.WeatherMetadata?.OutOfRangeCount</p>
                </div>
            </div>
        </div>
    </div>

    <section class="correlation-visualization mb-4" aria-labelledby="correlation-chart-title">
        <h4 id="correlation-chart-title">Przebieg temperatury</h4>
        <div class="correlation-chart-wrapper">
            <canvas id="correlation-chart" aria-label="Wykres temperatury czujnika i pogody" role="img"></canvas>
        </div>
        <div class="correlation-legend" aria-label="Legenda wykresu">
            <span><span class="correlation-legend-swatch correlation-legend-swatch-sensor" aria-hidden="true"></span>Czujnik</span>
            <span><span class="correlation-legend-swatch correlation-legend-swatch-weather" aria-hidden="true"></span>Pogoda</span>
            <span class="text-muted">Puste punkty oznaczają brak wartości poza zakresem</span>
        </div>
    </section>

    <h4>Wspólna tabela skorelowanych wartości</h4>
    <div class="table-responsive correlation-table-wrapper">
        <table class="table table-striped table-sm align-middle">
            <caption class="visually-hidden">Skorelowane wartości temperatury dla czujnika i pogody</caption>
            <thead>
                <tr>
                    <th scope="col">Timestamp</th>
                    <th scope="col">Czujnik [°C]</th>
                    <th scope="col">Status czujnika</th>
                    <th scope="col">Pogoda [°C]</th>
                    <th scope="col">Status pogody</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.TableRows)
                {
                    <tr>
                        <th scope="row">@row.Timestamp.ToString("yyyy-MM-dd HH:mm")</th>
                        <td>@(row.SensorValue?.ToString("F2") ?? "Brak")</td>
                        <td>@(row.SensorValue is null ? "Poza zakresem" : row.SensorIsInterpolated ? "Interpolowana" : "Źródłowa")</td>
                        <td>@(row.WeatherValue?.ToString("F2") ?? "Brak")</td>
                        <td>@(row.WeatherValue is null ? "Poza zakresem" : row.WeatherIsInterpolated ? "Interpolowana" : "Źródłowa")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script id="correlation-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TableRows))</script>
}
else
{
    <div class="alert alert-info">
        Brak danych do wyświetlenia. Wybierz zakres dat i kliknij „Oblicz korelację".
    </div>
}

@if (Model.HasExtremes)
{
    <h4 class="mt-4">Wykryte ekstrema</h4>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Źródło</th>
                    <th>Parametr</th>
                    <th>Wartość</th>
                    <th>Przekroczenie</th>
                    <th>Próg</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var extreme in Model.Extremes)
                {
                    <tr>
                        <td>@extreme.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@extreme.Source</td>
                        <td>@extreme.Parameter</td>
                        <td>@extreme.Value.ToString("F2")</td>
                        <td>@extreme.Direction</td>
                        <td>@extreme.Threshold.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.HasResults)
{
    <div class="alert alert-success mt-4" role="status">
        Nie wykryto ekstremów w wybranym zakresie.
    </div>
}

@if (Model.HasResults)
{
    @section Scripts {
        <script src="~/js/correlation-chart.js" asp-append-version="true"></script>
    }
}