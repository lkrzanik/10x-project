@using _10xPV.Services.Csv.Contracts
@model _10xPV.Models.ClimateImport.ClimateImportPageViewModel

@{
    ViewData["Title"] = "Import danych CSV";
}

<div class="row">
    <div class="col-lg-8">
        <h1 class="mb-3">Import danych CSV</h1>
        <p class="text-muted">Prześlij plik CSV i wybierz typ schematu danych do przetworzenia.</p>

        @if (TempData["ImportNotImplemented"] is string info)
        {
            <div class="alert alert-info" role="alert">@info</div>
        }

        <form asp-action="Index" asp-controller="ClimateImport" method="post" enctype="multipart/form-data" id="csv-import-form" class="card shadow-sm">
            <div class="card-body">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Form.File" class="form-label">Plik CSV</label>
                    <input asp-for="Form.File" type="file" class="form-control" accept=".csv,text/csv" />
                    <div class="form-text">Maksymalny rozmiar pliku: 10 MB.</div>
                    <span asp-validation-for="Form.File" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.SchemaType" class="form-label">Schemat importu</label>
                    <select asp-for="Form.SchemaType" class="form-select">
                        <option value="">-- Wybierz schemat --</option>
                        <option value="@CsvSchemaType.Sensor">Sensor</option>
                        <option value="@CsvSchemaType.Weather">Weather</option>
                    </select>
                    <span asp-validation-for="Form.SchemaType" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary" id="import-submit-button">Importuj plik</button>
                <span class="ms-3 text-muted d-none" id="import-progress-text">Przetwarzanie importu...</span>
            </div>
        </form>

        @if (Model.Summary is not null)
        {
            <section class="mt-4">
                <h2 class="h4">Podsumowanie importu</h2>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between"><span>Wiersze łącznie</span><strong>@Model.Summary.TotalRows</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Wiersze poprawne</span><strong>@Model.Summary.ValidRows</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Wiersze błędne</span><strong>@Model.Summary.InvalidRows</strong></li>
                </ul>
            </section>
        }

        @if (Model.Errors.Count > 0)
        {
            <section class="mt-4">
                <h2 class="h4">Błędy importu</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Linia</th>
                                <th>Pole</th>
                                <th>Kod</th>
                                <th>Komunikat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in Model.Errors)
                            {
                                <tr>
                                    <td>@error.LineNumber</td>
                                    <td>@(string.IsNullOrWhiteSpace(error.Field) ? "-" : error.Field)</td>
                                    <td><code>@error.Code</code></td>
                                    <td>@error.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            const form = document.getElementById('csv-import-form');
            if (!form) {
                return;
            }

            form.addEventListener('submit', function() {
                const button = document.getElementById('import-submit-button');
                const progressText = document.getElementById('import-progress-text');

                if (button) {
                    button.setAttribute('disabled', 'disabled');
                }

                if (progressText) {
                    progressText.classList.remove('d-none');
                }
            });
        })();
    </script>
}