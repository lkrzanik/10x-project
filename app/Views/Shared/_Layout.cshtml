<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 10xPV</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var isImportActive = string.Equals(currentController, "ClimateImport", StringComparison.OrdinalIgnoreCase);
        var isClimateDataActive = string.Equals(currentController, "ClimateData", StringComparison.OrdinalIgnoreCase);
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">10xPV</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                @if (isAuthenticated)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(isImportActive ? "active" : string.Empty)"
                               asp-controller="ClimateImport"
                               asp-action="Index"
                               aria-current="@(isImportActive ? "page" : null)">Import</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isClimateDataActive ? "active" : string.Empty)"
                               asp-controller="ClimateData"
                               asp-action="Sensor"
                               aria-current="@(isClimateDataActive ? "page" : null)">Dane</a>
                        </li>
                    </ul>
                }
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light text-center py-3 mt-auto">
        <div class="container">
            <small>&copy; @DateTime.Now.Year 10xPV</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
